# Copy to .env for local runs. On EC2 use a systemd EnvironmentFile instead.
# Never commit .env — it is gitignored.

# Required
DISCORD_TOKEN=your-discord-bot-token
OPENAI_API_KEY=sk-your-openai-key

# Optional (defaults shown)
# SQLite file; relative paths resolve from the working directory.
DB_PATH=moderation.db
MOD_LOG_CHANNEL=mod-logs
DASHBOARD_PORT=8000
# Bind address for the dashboard; keep loopback and reverse-proxy it if needed.
DASHBOARD_HOST=127.0.0.1
# Bearer token for the dashboard. Leave empty to disable the dashboard entirely.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
DASHBOARD_TOKEN=
# Comma-separated role IDs that are never auto-moderated (admins and
# manage_messages holders are always immune). Leave empty for none.
IMMUNE_ROLE_IDS=
